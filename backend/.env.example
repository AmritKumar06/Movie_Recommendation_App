# .env - Environment Variables (Backend)
# Copy this file as .env and fill in your values.
# NEVER commit the real .env to version control.

# ── OMDB API ──────────────────────────────────────────────────
# Get your free key at http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# ─── Flask ─────────────────────────────────────────────────────
FLASK_DEBUG=true
PORT=5000
