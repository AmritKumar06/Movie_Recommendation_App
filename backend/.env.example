# .env - Environment Variables (Backend)
# Copy this file as .env and fill in your values.
# NEVER commit the real .env to version control.

# ── TVDB API ──────────────────────────────────────────────────
# Get your free key at https://thetvdb.com/api-information
TVDB_API_KEY=your_tvdb_api_key_here

# ─── Flask ─────────────────────────────────────────────────────
FLASK_DEBUG=true
PORT=5000
