# .env - Environment Variables (Backend)
# Copy this file as .env and fill in your values.
# NEVER commit the real .env to version control.

# ── TMDB API ──────────────────────────────────────────────────
# Get your free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ─── Flask ─────────────────────────────────────────────────────
FLASK_DEBUG=true
PORT=5000
